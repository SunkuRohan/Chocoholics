# setup.sh creates a .env for you. Only copy this if you run docker compose by hand.
POSTGRES_PASSWORD=change-me
COOKIE_SECURE=false
TRUST_PROXY=
SEED_SAMPLE_REVIEWS=true
# Leave empty to start with admin / admin (you must change it at first login).
ADMIN_INITIAL_PASSWORD=
# Only for docker-compose.prod.yml (HTTPS with a domain)
DOMAIN=shop.example.com
